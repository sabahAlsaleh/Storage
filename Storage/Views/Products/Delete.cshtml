@model Storage.Models.Product
@{ ViewData["Title"] = "Delete Product"; }
<a class="back-link" asp-action="Index">&larr; Back to Products</a>
<div class="page-heading"><div><p class="eyebrow">DELETE PRODUCT</p><h1>Delete @Model.Name?</h1><p class="page-intro">Review the product before confirming.</p></div></div>
<section class="panel detail-panel" aria-label="Delete confirmation"><div class="delete-notice">This will permanently delete this product. This action cannot be undone.</div>
<partial name="_ProductDetails" model="Model" />
<form asp-action="Delete" method="post" class="form-actions"><input type="hidden" asp-for="Id" /><button type="submit" class="btn btn-danger">Delete Product</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></form></section>
