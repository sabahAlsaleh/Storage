@model Storage.Models.Product
@{ ViewData["Title"] = "Product Details"; }
<a class="back-link" asp-action="Index">&larr; Back to Products</a>
<div class="page-heading"><div><p class="eyebrow">PRODUCT DETAILS</p><h1>@Model.Name</h1><p class="page-intro">Product information at a glance.</p></div><a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit Product</a></div>
<section class="panel detail-panel" aria-label="Product information"><partial name="_ProductDetails" model="Model" /></section>
