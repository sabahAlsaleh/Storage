@model Storage.Models.Product
@{ ViewData["Title"] = "Edit Product"; }
<a class="back-link" asp-action="Index">&larr; Back to Products</a>
<div class="page-heading"><div><p class="eyebrow">PRODUCT INFORMATION</p><h1>Edit Product</h1><p class="page-intro">Update the product details below.</p></div></div>
<section class="panel form-panel" aria-label="Product details"><form asp-action="Edit" method="post">
<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<input type="hidden" asp-for="Id" />
<div class="row g-4">
<div class="col-md-6"><label asp-for="Name" class="form-label">Name</label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger field-validation"></span></div>
<div class="col-md-6"><label asp-for="Price" class="form-label">Price</label><input asp-for="Price" class="form-control" /><span asp-validation-for="Price" class="text-danger field-validation"></span></div>
<div class="col-md-6"><label asp-for="Orderdate" class="form-label">Order Date</label><input asp-for="Orderdate" class="form-control" /><span asp-validation-for="Orderdate" class="text-danger field-validation"></span></div>
<div class="col-md-6"><label asp-for="Category" class="form-label">Category</label><input asp-for="Category" class="form-control" /><span asp-validation-for="Category" class="text-danger field-validation"></span></div>
<div class="col-md-6"><label asp-for="Shelf" class="form-label">Shelf</label><input asp-for="Shelf" class="form-control" /><span asp-validation-for="Shelf" class="text-danger field-validation"></span></div>
<div class="col-md-6"><label asp-for="Count" class="form-label">Quantity</label><input asp-for="Count" class="form-control" /><span asp-validation-for="Count" class="text-danger field-validation"></span></div>
<div class="col-12"><label asp-for="Description" class="form-label">Description</label><textarea asp-for="Description" class="form-control" rows="4"></textarea><span asp-validation-for="Description" class="text-danger field-validation"></span></div>
</div><div class="form-actions"><button type="submit" class="btn btn-primary">Save Changes</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form></section>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
