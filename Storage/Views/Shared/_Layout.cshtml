@{
    var productSection = ViewContext.RouteData.Values["controller"]?.ToString() == "Products";
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var report = productSection && (action == "ProductInventory" || action == "FilterByCategory");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Storage</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Storage.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header"><nav class="container app-nav" aria-label="Main navigation">
        <a class="navbar-brand" asp-controller="Products" asp-action="Index">Storage</a>
        <div class="nav-links">
            <a class="nav-link @(!report && productSection ? "active" : "")" aria-current="@(!report && productSection ? "page" : null)" asp-controller="Products" asp-action="Index">Products</a>
            <a class="nav-link @(report ? "active" : "")" aria-current="@(report ? "page" : null)" asp-controller="Products" asp-action="ProductInventory">Inventory Report</a>
        </div>
    </nav></header>
    <main id="main-content" class="container app-main" tabindex="-1">@RenderBody()</main>
    <footer class="site-footer"><div class="container footer-content"><span>Storage &middot; Product inventory</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
